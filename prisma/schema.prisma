generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
model Memorial {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  birthDate   DateTime
  deathDate   DateTime
  biography   String?
  photoUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}